{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!test/golden/*.bytes",
      "!bench/results",
      "!openspec",
      "!assets"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noControlCharactersInRegex": "off" },
      "style": { "noNonNullAssertion": "off" }
    }
  }
}
