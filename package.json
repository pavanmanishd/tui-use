{
  "name": "@pavanmanishd/tui-use",
  "version": "1.0.0",
  "description": "Let any AI agent drive interactive terminal programs: vim, git rebase -i, npm init, ssh, REPLs, htop.",
  "keywords": [
    "mcp",
    "mcp-server",
    "terminal",
    "pty",
    "tui",
    "agent",
    "claude",
    "vim",
    "repl",
    "cli"
  ],
  "homepage": "https://github.com/pavanmanishd/tui-use#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavanmanishd/tui-use.git"
  },
  "bugs": {
    "url": "https://github.com/pavanmanishd/tui-use/issues"
  },
  "license": "Apache-2.0",
  "mcpName": "io.github.pavanmanishd/tui-use",
  "type": "module",
  "bin": {
    "tui-use": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "NOTICE",
    "npm-shrinkwrap.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check . && node scripts/check-pins.mjs",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:integration": "npm run build && vitest run --project integration",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
