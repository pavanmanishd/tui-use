"\u001b[?2004h\u001b[?1h\u001b=\u001b[?25l\u001b[1A\n\u001b[1;35m>>> \u001b[0m\u001b[4D\u001b[?12l\u001b[?25h\u001b[4C\u001b[?25l\u001b[4D\u001b[1;35m>>> \u001b[0mx\u001b[5D\u001b[?12l\u001b[?25h\u001b[5C\u001b[?25l\u001b[5D\u001b[1;35m>>> \u001b[0mx \u001b[6D\u001b[?12l\u001b[?25h\u001b[6C\u001b[?25l\u001b[6D\u001b[1;35m>>> \u001b[0mx =\u001b[7D\u001b[?12l\u001b[?25h\u001b[7C\u001b[?25l\u001b[7D\u001b[1;35m>>> \u001b[0mx = \u001b[8D\u001b[?12l\u001b[?25h\u001b[8C\u001b[?25l\u001b[8D\u001b[1;35m>>> \u001b[0mx = [\u001b[9D\u001b[?12l\u001b[?25h\u001b[9C\u001b[?25l\u001b[9D\u001b[1;35m>>> \u001b[0mx = [1\u001b[10D\u001b[?12l\u001b[?25h\u001b[10C\u001b[?25l\u001b[10D\u001b[1;35m>>> \u001b[0mx = [1,\u001b[11D\u001b[?12l\u001b[?25h\u001b[11C\u001b[?25l\u001b[11D\u001b[1;35m>>> \u001b[0mx = [1, \u001b[12D\u001b[?12l\u001b[?25h\u001b[12C\u001b[?25l\u001b[12D\u001b[1;35m>>> \u001b[0mx = [1, 2\u001b[13D\u001b[?12l\u001b[?25h\u001b[13C\u001b[?25l\u001b[13D\u001b[1;35m>>> \u001b[0mx = [1, 2,\u001b[14D\u001b[?12l\u001b[?25h\u001b[14C\u001b[?25l\u001b[14D\u001b[1;35m>>> \u001b[0mx = [1, 2, \u001b[15D\u001b[?12l\u001b[?25h\u001b[15C\u001b[?25l\u001b[15D\u001b[1;35m>>> \u001b[0mx = [1, 2, 3\u001b[16D\u001b[?12l\u001b[?25h\u001b[16C\u001b[?25l\u001b[16D\u001b[1;35m>>> \u001b[0mx = [1, 2, 3]\u001b[17D\u001b[?12l\u001b[?25h\u001b[17C\u001b[17D\n\r\u001b[?2004l\u001b[?1l\u001b>\u001b[?2004h\u001b[?1h\u001b=\u001b[?25l\u001b[1A\n\u001b[1;35m>>> \u001b[0m\u001b[4D\u001b[?12l\u001b[?25h\u001b[4C\u001b[?25l\u001b[4D\u001b[1;35m>>> \u001b[0ms\u001b[5D\u001b[?12l\u001b[?25h\u001b[5C\u001b[?25l\u001b[5D\u001b[1;35m>>> \u001b[0msu\u001b[6D\u001b[?12l\u001b[?25h\u001b[6C\u001b[?25l\u001b[6D\u001b[1;35m>>> \u001b[0msum\u001b[7D\u001b[?12l\u001b[?25h\u001b[7C\u001b[?25l\u001b[7D\u001b[1;35m>>> \u001b[0msum(\u001b[8D\u001b[?12l\u001b[?25h\u001b[8C\u001b[?25l\u001b[8D\u001b[1;35m>>> \u001b[0msum(x\u001b[9D\u001b[?12l\u001b[?25h\u001b[9C\u001b[?25l\u001b[9D\u001b[1;35m>>> \u001b[0msum(x)\u001b[10D\u001b[?12l\u001b[?25h\u001b[10C\u001b[?25l\u001b[10D\u001b[1;35m>>> \u001b[0msum(x) \u001b[11D\u001b[?12l\u001b[?25h\u001b[11C\u001b[?25l\u001b[11D\u001b[1;35m>>> \u001b[0msum(x) *\u001b[12D\u001b[?12l\u001b[?25h\u001b[12C\u001b[?25l\u001b[12D\u001b[1;35m>>> \u001b[0msum(x) * \u001b[13D\u001b[?12l\u001b[?25h\u001b[13C\u001b[?25l\u001b[13D\u001b[1;35m>>> \u001b[0msum(x) * 2\u001b[14D\u001b[?12l\u001b[?25h\u001b[14C\u001b[14D\n\r\u001b[?2004l\u001b[?1l\u001b>12\r\n\u001b[?2004h\u001b[?1h\u001b=\u001b[?25l\u001b[1A\n\u001b[1;35m>>> \u001b[0m\u001b[4D\u001b[?12l\u001b[?25h\u001b[4C"